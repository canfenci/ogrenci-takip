rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Only verified accounts may access student data.
    function isTeacher() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Owner checks
    function isOwner(resource) {
      return isTeacher() && resource.data.userId == request.auth.uid;
    }
    
    function isNewDocOwner() {
      return isTeacher() && request.resource.data.userId == request.auth.uid;
    }

    function keepsOwnership() {
      return request.resource.data.userId == resource.data.userId;
    }

    // Teacher has read/write permissions on all core collections, restricted by userId
    match /students/{studentId} {
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && keepsOwnership();
      allow create: if isNewDocOwner();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /schedules/{studentId} {
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && keepsOwnership();
      allow create: if isNewDocOwner();
    }

    match /lessons/{studentId} {
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && keepsOwnership();
      allow create: if isNewDocOwner();
    }
    
    match /groups/{groupId} {
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && keepsOwnership();
      allow create: if isNewDocOwner();
    }

    // Homeworks collection
    match /homeworks/{hwId} {
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && keepsOwnership();
      allow create: if isNewDocOwner();
    }
  }
}
